# Подключение к Postgres из docker-compose.yml
DATABASE_URL="postgresql://triply:triply@localhost:5433/triply?schema=public"

# Адрес приложения в браузере: из него собираются ссылки в письмах
APP_URL="http://localhost:3000"

# Почта. Без MAIL_SMTP_HOST письмо печатается в консоль сервера — этого хватает,
# чтобы пройти восстановление пароля сразу после клонирования. С docker compose
# письма принимает Mailpit, а читать их можно на http://localhost:8025
MAIL_SMTP_HOST="localhost"
MAIL_SMTP_PORT="1025"
MAIL_FROM="Triply <no-reply@triply.local>"

# Для настоящего почтового сервера: логин с паролем уходят только по шифрованному
# каналу, MAIL_SMTP_SECURE — это TLS с первого байта (обычно порт 465)
# MAIL_SMTP_USER=""
# MAIL_SMTP_PASSWORD=""
# MAIL_SMTP_SECURE="1"

# База для тестов. Не задана — берётся соседняя с суффиксом _test (triply_test):
# тесты на права чистят таблицы целиком, и делать это в базе разработки нельзя.
# TEST_DATABASE_URL="postgresql://triply:triply@localhost:5433/triply_test"
